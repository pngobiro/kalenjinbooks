// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?   // Optional for OAuth users
  name          String?
  image         String?   // Profile image from OAuth
  googleId      String?   @unique // Google OAuth ID
  role          UserRole  @default(READER)
  isAdmin       Boolean   @default(false) // Additional admin privileges
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  author        Author?
  purchases     Purchase[]
  accessLinks   TimeAccessLink[]
}

enum UserRole {
  READER
  AUTHOR
  ADMIN
}

model Author {
  id            String    @id @default(uuid())
  userId        String    @unique
  bio           String?
  profileImage  String?
  phoneNumber   String?
  paymentMethod String?   // e.g., "mpesa", "bank", "stripe"
  paymentDetails String?  // JSON string with payment info
  paymentMethods String?  // JSON array of enabled checkout methods, e.g. ["mpesa","stripe","paypal"]
  totalEarnings Float     @default(0)
  status        AuthorStatus @default(PENDING)
  rejectionReason String? // Reason if rejected
  appliedAt     DateTime  @default(now())
  approvedAt    DateTime?
  isActive      Boolean   @default(true) // Admin can disable authors
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Enhanced Personal Information
  dateOfBirth   String?
  nationality   String?
  location      String?
  
  // Professional Information
  education     String?
  occupation    String?
  writingExperience String?
  previousPublications String?
  awards        String?
  
  // Writing Information
  genres        String?   // JSON array of genres
  languages     String?   // JSON array of languages
  writingStyle  String?
  inspirations  String?
  targetAudience String?
  publishingGoals String?
  
  // Social Media & Online Presence
  website       String?
  twitter       String?
  facebook      String?
  instagram     String?
  linkedin      String?
  
  // Additional Information
  howDidYouHear String?
  additionalInfo String?
  agreeToMarketing Boolean @default(false)
  
  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  books         Book[]
  payments      Payment[]
  blogPosts     BlogPost[]
  hardCopyRequests HardCopyRequest[]
}

enum AuthorStatus {
  PENDING
  APPROVED
  REJECTED
}

model Book {
  id            String    @id @default(uuid())
  title         String
  description   String?
  coverImage    String?
  fileKey       String    // R2 object key
  fileSize      Int       // in bytes
  fileType      String    // pdf, epub
  price         Float
  rentalPrice   Float?    // 24-hour access price
  previewPages  Int       @default(10)
  category      String?
  language      String    @default("Kalenjin")
  isbn          String?   // ISBN number
  tags          String?   // JSON array of tags
  publishedAt   DateTime?
  isPublished   Boolean   @default(false)
  isFeatured    Boolean   @default(false)
  featuredOrder Int?      // Order in featured list (lower = first)
  rating        Float     @default(0)
  reviewCount   Int       @default(0)
  isActive      Boolean   @default(true) // Admin can disable books
  authorId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  author        Author    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  purchases     Purchase[]
  accessLinks   TimeAccessLink[]
  hardCopyRequests HardCopyRequest[]
}

model Purchase {
  id            String    @id @default(uuid())
  userId        String
  bookId        String
  amount        Float
  platformFee   Float
  authorEarning Float
  stripePaymentId String?
  mpesaPaymentId  String?
  status        PurchaseStatus @default(PENDING)
  purchasedAt   DateTime  @default(now())
  
  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book          Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id            String    @id @default(uuid())
  authorId      String
  amount        Float
  status        PaymentStatus @default(PENDING)
  method        String    // mpesa, bank_transfer
  reference     String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  
  // Relations
  author        Author    @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model TimeAccessLink {
  id            String    @id @default(uuid())
  token         String    @unique
  userId        String
  bookId        String
  expiresAt     DateTime
  isRevoked     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  
  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book          Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  content       String    // Rich text HTML content
  excerpt       String?   // Short summary for listings
  coverImage    String?   // R2 key for cover image
  coverType     String    @default("image") // 'image' | 'video'
  coverVideoUrl String?   // YouTube/Vimeo/MP4 URL used as hero media
  category      String?   // Blog category (e.g. Culture, Stories, News, Guides)
  tags          String?   // JSON array of tags
  scheduledAt   DateTime?
  isFeatured    Boolean   @default(false)
  authorId      String
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  author        Author    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images        BlogImage[]
}

model BlogImage {
  id            String    @id @default(uuid())
  blogPostId    String
  imageKey      String    // R2 object key
  altText       String?   // Accessibility text
  createdAt     DateTime  @default(now())
  
  // Relations
  blogPost      BlogPost  @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
}

// Analytics Models
model AnalyticsEvent {
  id            String    @id @default(uuid())
  eventType     EventType
  bookId        String?
  authorId      String?
  userId        String?
  sessionId     String?   // Anonymous session tracking
  metadata      String?   // JSON string with additional data
  ipAddress     String?
  userAgent     String?
  referrer      String?
  createdAt     DateTime  @default(now())
  
  @@index([eventType])
  @@index([bookId])
  @@index([authorId])
  @@index([createdAt])
}

enum EventType {
  BOOK_VIEW         // Book detail page viewed
  BOOK_CLICK        // Book clicked from list
  BOOK_SEARCH       // Book searched
  BOOK_PREVIEW      // Preview opened
  BOOK_PURCHASE     // Book purchased
  BOOK_DOWNLOAD     // Book downloaded
  AUTHOR_VIEW       // Author profile viewed
  AUTHOR_FOLLOW     // Author followed
  PAGE_VIEW         // General page view
  SIGNUP            // User signed up
  LOGIN             // User logged in
}

model DailyStats {
  id            String    @id @default(uuid())
  date          String    @unique // YYYY-MM-DD format
  totalViews    Int       @default(0)
  totalClicks   Int       @default(0)
  totalPurchases Int      @default(0)
  totalRevenue  Float     @default(0)
  uniqueVisitors Int      @default(0)
  newUsers      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([date])
}

model BookAnalytics {
  id            String    @id @default(uuid())
  bookId        String    @unique
  views         Int       @default(0)
  clicks        Int       @default(0)
  previews      Int       @default(0)
  purchases     Int       @default(0)
  downloads     Int       @default(0)
  revenue       Float     @default(0)
  lastViewedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([bookId])
}

// Hard Copy Request Model
model HardCopyRequest {
  id            String    @id @default(uuid())
  bookId        String
  authorId      String
  
  // Requester Information
  requesterName     String
  requesterEmail    String
  requesterPhone    String
  
  // Delivery Information
  deliveryAddress   String
  city              String
  country           String
  postalCode        String?
  
  // Request Details
  quantity          Int       @default(1)
  message           String?   // Optional message to author
  
  // Status
  status            HardCopyRequestStatus @default(PENDING)
  authorResponse    String?   // Author's response/notes
  estimatedPrice    Float?    // Price quoted by author
  estimatedDelivery String?   // Estimated delivery time
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  respondedAt       DateTime? // When author responded
  
  // Relations
  book              Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author            Author    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  @@index([authorId])
  @@index([bookId])
  @@index([status])
  @@index([createdAt])
}

enum HardCopyRequestStatus {
  PENDING       // New request, awaiting author response
  ACCEPTED      // Author accepted and provided details
  DECLINED      // Author declined the request
  COMPLETED     // Order fulfilled
  CANCELLED     // Cancelled by requester
}
